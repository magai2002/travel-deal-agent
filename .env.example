# InfluxDB (same instance as the market-data collector, separate bucket)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=changeme
INFLUX_ORG=quantfinance
TRAVEL_BUCKET=travel_deals

# Anthropic API key, for the deal-digest step
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: point at a self-hosted flix-rest instance instead of the public one
FLIXBUS_API_BASE=https://1.flixbus.transport.rest

# Run metrics (see src/metrics.py) — exported after every run so a broken
# run/timer/collector is visible in Grafana instead of silently indistinguishable
# from "nothing was cheap today".
METRICS_BACKEND=textfile   # or "pushgateway"
METRICS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/travel_agent.prom
# METRICS_PUSHGATEWAY_URL=http://localhost:9091   # only if METRICS_BACKEND=pushgateway

# Conversational assistant (src/assistant/) — separate, on-demand entry
# point: python -m src.assistant.cli
ASSISTANT_MODEL=claude-sonnet-5
ASSISTANT_STATE_DB=assistant_state.db
ASSISTANT_THREAD_ID=default
# CONFIG_PATH=config/routes.yaml   # only needed if routes.yaml isn't at the default relative path

# Assistant web UI (src/assistant/web.py) — uvicorn src.assistant.web:app,
# see deploy/travel-assistant-web.service. Own LangGraph thread, separate
# from the CLI's, in the same ASSISTANT_STATE_DB. Gated by HTTP Basic Auth —
# ASSISTANT_WEB_PASSWORD MUST be set or the app refuses to start.
ASSISTANT_WEB_USER=alexey
ASSISTANT_WEB_PASSWORD=changeme
ASSISTANT_WEB_THREAD_ID=web

# Public demo (src/demo/) — unauthenticated, rate-limited showcase linked
# from the README. Real Flixbus check for Brussels<->Paris only, one Claude
# call per visit, nothing written to InfluxDB or routes.yaml.
DEMO_MODEL=claude-haiku-4-5-20251001
DEMO_RATE_LIMIT_DB=demo_rate_limit.db
DEMO_GLOBAL_DAILY_CAP=20
