# InfluxDB (same instance as the market-data collector, separate bucket)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=changeme
INFLUX_ORG=quantfinance
TRAVEL_BUCKET=travel_deals

# Anthropic API key, for the deal-digest step
ANTHROPIC_API_KEY=changeme
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: point at a self-hosted flix-rest instance instead of the public one
FLIXBUS_API_BASE=https://1.flixbus.transport.rest

# Run metrics (see src/metrics.py) — exported after every run so a broken
# run/timer/collector is visible in Grafana instead of silently indistinguishable
# from "nothing was cheap today".
METRICS_BACKEND=textfile   # or "pushgateway"
METRICS_TEXTFILE_PATH=/var/lib/node_exporter/textfile_collector/travel_agent.prom
# METRICS_PUSHGATEWAY_URL=http://localhost:9091   # only if METRICS_BACKEND=pushgateway
