[Unit]
Description=Travel deal assistant web UI
After=network-online.target influxdb.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/travel-deal-agent
EnvironmentFile=/root/travel-deal-agent/.env
# Binds to localhost only — put this behind the box's existing Nginx for
# TLS and external access rather than exposing uvicorn directly.
ExecStart=/root/travel-deal-agent/venv/bin/uvicorn src.assistant.web:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
